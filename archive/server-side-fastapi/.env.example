# =============================================================
# LocInsight ML Engine — Environment Variables
# Copy to .env for local development.
# On Hugging Face Spaces, set these as "Secrets" (not Variables).
# =============================================================

# --- Supabase ---
SUPABASE_URL=https://fcyhrzzfvdsghtummizv.supabase.co
# Service role key (NOT the publishable/anon key) — bypasses RLS
# Get from: Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# --- API Security ---
# Custom bearer token securing this API (only Vercel backend should call)
# Generate a strong random string, e.g., `openssl rand -hex 32`
LOCINSIGHT_API_TOKEN=

# --- CORS ---
# Comma-separated list of allowed origins (Vercel app URL)
# For production: https://locinsights.vercel.app,https://*.vercel.app
CORS_ALLOWED_ORIGINS=*

# --- ML Model ---
MODEL_NAME=gbr_site_scoring
MODEL_VERSION=1.0.0
MODEL_ARTIFACT_PATH=artifacts/gbr_site_scoring.json

# --- Scraper ---
NOMINATIM_USER_AGENT=LocInsight/1.0 (bayhaqy@mapactive.id)
OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter
SCRAPE_REQUEST_TIMEOUT=30
